# Copy this file to `.env` and fill in your own values. `.env` is gitignored — never commit it.

# Google Gemini API Key (Required for Gemini 2.5 Flash / Pro scoring, resume tailoring, and HR cold email generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gmail SMTP credentials for sending approved HR cold emails directly
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
# (Do NOT use your normal Gmail account password here.)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: Hunter.io / Apollo API Key for verifying corporate HR emails
HUNTER_API_KEY=
APOLLO_API_KEY=
